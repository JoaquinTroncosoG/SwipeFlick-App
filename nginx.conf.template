server {
    listen ${PORT};
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Endpoint de Health Check para Render
    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
